<style>
  .groomly-announcement-bar {
    background: linear-gradient(90deg, #1a1a2e, #0f3460, #c9a84c, #0f3460, #1a1a2e);
    background-size: 300% 100%;
    animation: gradientShift 6s ease infinite;
    padding: 10px 0;
    overflow: hidden;
    position: relative;
    z-index: 100;
    box-shadow: 0 2px 10px rgba(201,168,76,0.4);
  }
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .ticker-wrapper { display: flex; width: 100%; overflow: hidden; }
  .ticker-content {
    display: flex;
    animation: ticker 40s linear infinite;
    white-space: nowrap;
    align-items: center;
  }
  .ticker-content:hover { animation-play-state: paused; }
  @keyframes ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    padding: 0 30px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #ffffff;
    text-transform: uppercase;
  }
  .ticker-item .icon {
    margin-right: 8px;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }
  .ticker-item .highlight { color: #ffd700; margin: 0 4px; }
  .ticker-separator { color: #c9a84c; font-size: 18px; padding: 0 15px; font-weight: 900; }
  .flash-badge {
    background: #c9a84c;
    color: #1a1a2e;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 900;
    margin-left: 6px;
    animation: flashBadge 1.5s ease-in-out infinite;
  }
  @keyframes flashBadge {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.08); }
  }
  .bnpl-mini { display: inline-flex; align-items: center; gap: 4px; margin-left: 8px; vertical-align: middle; }
  .bnpl-chip { display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: 10px; font-weight: 900; letter-spacing: 0; text-transform: none; line-height: 1.4; }
  .bnpl-chip.ap { background: #B2FCE4; color: #000; }
  .bnpl-chip.zp { background: #1A0826; color: #AA8FFF; }
  .bnpl-chip.kl { background: #FFB3C7; color: #000; }
</style>

