.g-product-badge-wrap{position:absolute;top:12px;left:12px;display:flex;flex-direction:column;gap:6px;z-index:2;}
.g-badge-sale{background:#e63946;color:white;font-size:11px;font-weight:900;padding:4px 10px;border-radius:20px;}
.g-badge-hot,.g-badge-new{background:linear-gradient(135deg,#c9a84c,#f0d080);color:#fff;font-size:11px;font-weight:900;padding:4px 10px;border-radius:20px;}
.g-badge-bundle{background:linear-gradient(135deg,#c9a84c,#f0d080);color:#fff;font-size:12px;font-weight:900;padding:6px 14px;border-radius:20px;}
.g-product-img-wrap{height:200px;background:#f5f0e8;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.g-product-img-placeholder{font-size:80px;}
.g-product-info{padding:20px;}
.g-product-brand{font-size:11px;font-weight:800;color:#a8852e !important;letter-spacing:2px;text-transform:uppercase;margin:0 0 6px;}
.g-product-title{font-size:18px;font-weight:800;color:#2d2416 !important;margin:0 0 8px;}
.g-product-stars{font-size:13px;color:#9c8b72 !important;margin-bottom:10px;}
.g-product-price{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.g-price-sale{font-size:20px;font-weight:900;color:#a8852e !important;}
.g-price-original{font-size:14px;color:#9c8b72 !important;text-decoration:line-through;}
.g-product-desc{font-size:12px;color:#9c8b72 !important;margin-bottom:16px;}
.g-product-btn{display:block;text-align:center;background:linear-gradient(135deg,#c9a84c,#f0d080);color:#fff !important;font-weight:900;font-size:13px;text-transform:uppercase;letter-spacing:1px;padding:14px;border-radius:50px;text-decoration:none;transition:all 0.3s ease;}
.g-product-btn:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(201,168,76,0.35);}
.g-product-urgency{font-size:12px;color:#e63946 !important;font-weight:700;text-align:center;margin:10px 0 0;}
.g-bundle-card{background:linear-gradient(135deg,#fffdf5,#faf5e4);border-color:rgba(201,168,76,0.4);}
.g-bundle-content{padding:40px 20px 20px;text-align:center;}
.g-bundle-icons{font-size:50px;margin-bottom:16px;}
.g-bundle-desc{color:#6b5a3e !important;font-size:14px;margin-bottom:16px;line-height:1.6;}
.g-bundle-includes{text-align:left;margin-bottom:20px;}
.g-bundle-includes p{font-size:13px;color:#6b5a3e !important;margin:6px 0;}
.g-bundle-btn{background:linear-gradient(135deg,#c9a84c,#f0d080,#c9a84c) !important;background-size:200% !important;animation:goldShimmer 3s ease infinite !important;color:#fff !important;}
.g-why-section{padding:80px 20px;background:#ede8dc;text-align:center;}
.g-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px;}
@media(max-width:768px){.g-why-grid{grid-template-columns:1fr;}}
.g-why-item{background:#fff;border:1px solid rgba(201,168,76,0.15);border-radius:16px;padding:30px 20px;transition:all 0.3s ease;}
.g-why-item:hover{border-color:rgba(201,168,76,0.4);transform:translateY(-4px);box-shadow:0 10px 30px rgba(201,168,76,0.08);}
.g-why-icon{font-size:40px;display:block;margin-bottom:16px;}
.g-why-item h4{color:#a8852e !important;font-size:16px;font-weight:800;margin:0 0 10px;text-transform:uppercase;letter-spacing:0.5px;}
.g-why-item p{color:#6b5a3e !important;font-size:14px;line-height:1.6;margin:0;}
.g-reviews-section{padding:80px 20px;background:#f5f0e8;text-align:center;}
.g-reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px;}
@media(max-width:900px){.g-reviews-grid{grid-template-columns:1fr;}}
.g-review-card{background:#fff;border:1px solid rgba(201,168,76,0.2);border-radius:16px;padding:24px;text-align:left;transition:all 0.3s ease;}
.g-review-card:hover{border-color:rgba(201,168,76,0.4);transform:translateY(-4px);box-shadow:0 10px 30px rgba(201,168,76,0.08);}
.g-review-stars{font-size:16px;margin-bottom:12px;}
.g-review-text{color:#6b5a3e !important;font-size:14px;line-height:1.8;margin-bottom:16px;font-style:normal !important;quotes:none !important;}
.g-review-text::before,.g-review-text::after{content:none !important;}
.g-review-author{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.g-review-avatar{width:38px;height:38px;background:linear-gradient(135deg,#c9a84c,#f0d080);color:#fff;font-weight:900;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.g-review-author strong{color:#2d2416 !important;font-size:14px;display:block;}
.g-review-author span{color:#9c8b72 !important;font-size:12px;}
.g-review-meta{display:flex;align-items:center;justify-content:space-between;}
.g-review-verified{font-size:11px;color:#4caf50 !important;font-weight:700;}
.g-review-date{font-size:11px;color:#9c8b72 !important;}
.g-cta-section{padding:80px 20px;background:#ede8dc;text-align:center;}
.g-cta-box{background:linear-gradient(135deg,#fffdf5,#faf5e4);border:1px solid rgba(201,168,76,0.4);border-radius:24px;padding:60px 40px;max-width:700px;margin:0 auto;box-shadow:0 20px 60px rgba(201,168,76,0.1);}
.g-cta-title{font-size:clamp(1.8rem,4vw,2.5rem);font-weight:900;color:#2d2416 !important;margin-bottom:12px;}
.g-cta-sub{color:#6b5a3e !important;font-size:16px;margin-bottom:24px;}
.g-cta-offer{display:inline-block;background:rgba(201,168,76,0.1);border:1px dashed rgba(201,168,76,0.4);color:#a8852e !important;padding:12px 24px;border-radius:10px;font-size:15px;font-weight:700;margin-bottom:30px;}
.g-cta-offer strong{color:#c9a84c !important;}
.g-cta-btn{font-size:17px !important;padding:20px 50px !important;}
.g-cta-trust{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;font-size:13px;color:#9c8b72 !important;margin-top:20px;font-weight:600;}
@keyframes goldShimmer{0%{background-position:0% 50%;}50%{background-position:100% 50%;}100%{background-position:0% 50%;}}
</style>

