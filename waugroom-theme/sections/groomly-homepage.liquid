.g-hero-badge{display:inline-block;background:linear-gradient(135deg,#c9a84c,#f0d080);color:#fff;padding:8px 20px;border-radius:50px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1px;margin-bottom:24px;animation:badgePulse 2s ease-in-out infinite;}
