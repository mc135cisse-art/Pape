.g-whatsapp-float{position:fixed;bottom:150px;right:24px;width:56px;height:56px;background:#25d366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 24px rgba(37,211,102,0.4);z-index:9992;text-decoration:none;animation:waPulse 2s ease-in-out infinite}
