<script>
function showPopup(){if(!sessionStorage.getItem('waugroomPopupShown')){document.getElementById('groomlyPopup').classList.remove('hidden');sessionStorage.setItem('waugroomPopupShown','1');}}
function closePopup(){document.getElementById('groomlyPopup').classList.add('hidden');}
function copyCode(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText('WAUGROOM10').then(function(){var h=document.querySelector('.g-popup-copy-hint');if(h)h.textContent='✅ Skopiowano! Wklej przy kasie';});}}
setTimeout(showPopup,8000);
document.getElementById('groomlyPopup').addEventListener('click',function(e){if(e.target===this)closePopup();});
var toastData=[
  {icon:'🛋️',title:'Zweryfikowany klient',product:'Ochraniacz na Kanapę (Duży)',loc:'📍 Warszawa · 2 min temu'},
  {icon:'🧤',title:'Właściciel psa z Krakowa',product:'Rękawica do Pielęgnacji',loc:'📍 Kraków · 5 min temu'},
  {icon:'🛋️',title:'Zweryfikowany klient',product:'Ochraniacz na Kanapę (XL)',loc:'📍 Wrocław · 8 min temu'},
  {icon:'🎁',title:'Zadowolony kupujący',product:'Kompletny Zestaw',loc:'📍 Gdańsk · 11 min temu'},
  {icon:'🧤',title:'Zweryfikowany klient',product:'Rękawica do Pielęgnacji',loc:'📍 Poznań · 14 min temu'},
  {icon:'🛋️',title:'Właściciel psa',product:'Ochraniacz na Kanapę (Średni)',loc:'📍 Łódź · 17 min temu'},
  {icon:'🎁',title:'Zweryfikowany klient',product:'Kompletny Zestaw',loc:'📍 Szczecin · 20 min temu'},
  {icon:'🛋️',title:'Zadowolony kupujący',product:'Ochraniacz na Kanapę (Mały)',loc:'📍 Katowice · 23 min temu'},
  {icon:'🧤',title:'Właściciel psa z Lublina',product:'Rękawica do Pielęgnacji',loc:'📍 Lublin · 26 min temu'},
  {icon:'🛋️',title:'Zweryfikowany klient',product:'Ochraniacz na Kanapę (XL)',loc:'📍 Bydgoszcz · 29 min temu'}
];
var ti=0;
function showToast(){
  var d=toastData[ti%toastData.length];
  var t=document.getElementById('groomlyToast');
  document.getElementById('toastIcon').textContent=d.icon;
  document.getElementById('toastTitle').textContent=d.title;
  document.getElementById('toastProduct').textContent=d.product;
  document.getElementById('toastLoc').textContent=d.loc;
  t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},4500);
  ti++;
}
setTimeout(function(){showToast();setInterval(showToast,28000);},5000);
window.addEventListener('scroll',function(){var b=document.getElementById('scrollTop');if(window.scrollY>400)b.classList.add('visible');else b.classList.remove('visible');});
function acceptCookies(){localStorage.setItem('waugroomCookieAccepted','1');document.getElementById('groomlyCookie').classList.remove('show');}
if(!localStorage.getItem('waugroomCookieAccepted')){setTimeout(function(){document.getElementById('groomlyCookie').classList.add('show');},2000);}
var exitShown=false;
document.addEventListener('mouseleave',function(e){if(e.clientY<10&&!exitShown&&!sessionStorage.getItem('waugroomExitShown')){exitShown=true;sessionStorage.setItem('waugroomExitShown','1');document.getElementById('groomlyExit').classList.remove('hidden');}});
function closeExit(){document.getElementById('groomlyExit').classList.add('hidden');}
function copyExitCode(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText('WAUGROOM10').then(function(){var el=document.querySelector('.g-exit-code span');if(el)el.textContent='✅ Skopiowano! Wklej przy kasie';});}}
document.getElementById('groomlyExit').addEventListener('click',function(e){if(e.target===this)closeExit();});
(function(){if(sessionStorage.getItem('bnplShown'))return;setTimeout(function(){var el=document.getElementById('bnplFloat');if(el){el.classList.add('show');sessionStorage.setItem('bnplShown','1');}},7000);})();
document.addEventListener('DOMContentLoaded',function(){
  var bnplW=document.getElementById('g-prod-bnpl-widget');
  if(bnplW){
    var buyBtnEl=document.querySelector('.product-form__submit')||document.querySelector('[name="add"]');
    if(buyBtnEl){
      var btnBox=buyBtnEl.closest('.product-form__buttons')||buyBtnEl.closest('form')||buyBtnEl.parentNode;
      if(btnBox&&btnBox.parentNode){btnBox.parentNode.insertBefore(bnplW,btnBox.nextSibling);bnplW.style.display='block';}
    }
  }
  document.addEventListener('click',function(ev){
    var clickedBtn=ev.target.closest('[name="add"]')||ev.target.closest('.product-form__submit');
    if(!clickedBtn)return;
    setTimeout(function(){
      var ct=document.getElementById('groomlyCartToast');
      if(ct){ct.classList.add('show');setTimeout(function(){ct.classList.remove('show');},6000);}
    },1200);
  });
});
</script>
