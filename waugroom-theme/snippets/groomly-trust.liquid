@keyframes waPulse{0%,100%{box-shadow:0 6px 24px rgba(37,211,102,0.4)}50%{box-shadow:0 6px 40px rgba(37,211,102,0.7)}}
.g-whatsapp-float svg{width:28px;height:28px;fill:white}
.g-whatsapp-tooltip{position:absolute;right:66px;background:#2d2416;color:#fff;font-size:12px;font-weight:700;padding:8px 14px;border-radius:8px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity 0.3s ease}
